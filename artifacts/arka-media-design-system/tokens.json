{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "ARKA OS visual language extracted from the existing ARKA Digital Media operating system: near-black navigation, warm gold emphasis, ivory workspace surfaces, muted gray structure, and role-aware operational clarity.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f7f7f5" },
      "foreground": { "$value": "#141414" },
      "border": { "$value": "#deddd8" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#141414" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#141414" },
      "primary": { "$value": "#bf9218", "$description": "Warm gold for primary actions, active states, and founder-level emphasis." },
      "primaryForeground": { "$value": "#0d0d0d" },
      "secondary": { "$value": "#ebeae7" },
      "secondaryForeground": { "$value": "#1c1c1c" },
      "muted": { "$value": "#edebe7" },
      "mutedForeground": { "$value": "#6b6b6b" },
      "accent": { "$value": "#fabe1f", "$description": "Bright gold highlight used for attention, selection, and branded moments." },
      "accentForeground": { "$value": "#0d0d0d" },
      "destructive": { "$value": "#d94d43" },
      "destructiveForeground": { "$value": "#fffaf3" },
      "input": { "$value": "#c9c7c0" },
      "ring": { "$value": "#bf9218" },
      "chart1": { "$value": "#bf9218" },
      "chart2": { "$value": "#1a1a1a" },
      "chart3": { "$value": "#18a1e9" },
      "chart4": { "$value": "#c5844c" },
      "chart5": { "$value": "#7a7a7a" },
      "sidebar": { "$value": "#0a0a0a" },
      "sidebarForeground": { "$value": "#f1efe8" },
      "sidebarBorder": { "$value": "#2e2e2e" },
      "sidebarPrimary": { "$value": "#fabe1f" },
      "sidebarPrimaryForeground": { "$value": "#0d0d0d" },
      "sidebarAccent": { "$value": "#1f1f1f" },
      "sidebarAccentForeground": { "$value": "#f1efe8" },
      "sidebarRing": { "$value": "#fabe1f" }
    },
    "dark": {
      "background": { "$value": "#121212" },
      "foreground": { "$value": "#f1efe8" },
      "border": { "$value": "#383838" },
      "card": { "$value": "#1c1c1c" },
      "cardForeground": { "$value": "#f1efe8" },
      "popover": { "$value": "#1c1c1c" },
      "popoverForeground": { "$value": "#f1efe8" },
      "primary": { "$value": "#fabe1f" },
      "primaryForeground": { "$value": "#0d0d0d" },
      "secondary": { "$value": "#2d2d2d" },
      "secondaryForeground": { "$value": "#f1efe8" },
      "muted": { "$value": "#292929" },
      "mutedForeground": { "$value": "#aaa79e" },
      "accent": { "$value": "#fabe1f" },
      "accentForeground": { "$value": "#0d0d0d" },
      "destructive": { "$value": "#ec6a5f" },
      "destructiveForeground": { "$value": "#1b0b09" },
      "input": { "$value": "#4b4b4b" },
      "ring": { "$value": "#fabe1f" },
      "chart1": { "$value": "#fabe1f" },
      "chart2": { "$value": "#f1efe8" },
      "chart3": { "$value": "#49b8f0" },
      "chart4": { "$value": "#d99b62" },
      "chart5": { "$value": "#aaa79e" },
      "sidebar": { "$value": "#080808" },
      "sidebarForeground": { "$value": "#f1efe8" },
      "sidebarBorder": { "$value": "#242424" },
      "sidebarPrimary": { "$value": "#fabe1f" },
      "sidebarPrimaryForeground": { "$value": "#0d0d0d" },
      "sidebarAccent": { "$value": "#1c1c1c" },
      "sidebarAccentForeground": { "$value": "#f1efe8" },
      "sidebarRing": { "$value": "#fabe1f" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": { "$value": ["DM Sans", "sans-serif"], "$description": "Operational UI and body copy." },
      "serif": { "$value": ["Georgia", "serif"], "$description": "Reserved fallback for editorial or long-form content." },
      "mono": { "$value": ["Space Mono", "monospace"], "$description": "Timestamps, IDs, and compact operational metadata." }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.8rem", "$description": "Soft but controlled corners used across cards, fields, buttons, and status surfaces." }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem", "$description": "Four-pixel rhythm used to build the compact operational layout." }
  }
}