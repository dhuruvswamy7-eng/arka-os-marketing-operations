    "@swc/helpers": "^0.5.23",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "googleapis": "^180.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "multer-s3": "^3.0.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.9",
    "pdfkit": "^0.20.2",
